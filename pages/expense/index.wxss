.expense-page {
  min-height: 100vh;
  background: #fef9f3;
  padding: 0 24rpx 40rpx;
}

.expense-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 8rpx 24rpx;
}

.header-back-btn,
.header-add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 4rpx solid #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  font-size: 36rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.header-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.month-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.month-chip {
  display: inline-flex;
  padding: 18rpx 28rpx;
  background: #FFF3CD;
  color: #5E4E3E;
  border-radius: 24rpx;
  border: 3rpx solid #5E4E3E;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  font-size: 24rpx;
  font-weight: 900;
}

.refresh-btn {
  min-width: 132rpx;
  height: 68rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 3rpx solid #5E4E3E;
  background: #DFFFDF;
  color: #5E4E3E;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.refresh-btn.refreshing {
  opacity: 0.72;
}

.summary-card {
  background: #fff;
  border: 4rpx solid #5E4E3E;
  border-radius: 32rpx;
  box-shadow: 6rpx 6rpx 0 #5E4E3E;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.summary-card-top,
.summary-meta-row,
.summary-action-row,
.entry-top-row,
.entry-bottom-row,
.modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-title,
.section-title,
.entry-desc,
.modal-title,
.form-label {
  color: #5E4E3E;
  font-weight: 900;
}

.summary-title,
.section-title {
  font-size: 28rpx;
}

.summary-month,
.entry-date,
.entry-invoice,
.entry-status {
  font-size: 20rpx;
  color: #8B7E74;
  font-weight: 700;
}

.summary-amount-row {
  display: flex;
  align-items: baseline;
  margin: 20rpx 0 24rpx;
}

.summary-currency {
  font-size: 30rpx;
  color: #5E4E3E;
  font-weight: 900;
  margin-right: 8rpx;
}

.summary-amount {
  font-size: 64rpx;
  color: #FF9F43;
  font-weight: 900;
}

.summary-meta-item {
  flex: 1;
  text-align: center;
}

.summary-meta-label {
  display: block;
  color: #8B7E74;
  font-size: 18rpx;
}

.summary-meta-value {
  display: block;
  margin-top: 8rpx;
  color: #5E4E3E;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(94, 78, 62, 0.15);
}

.summary-action-row {
  gap: 16rpx;
  margin-top: 28rpx;
}

.summary-primary-btn,
.summary-secondary-btn,
.footer-btn {
  height: 84rpx;
  border-radius: 24rpx;
  border: 3rpx solid #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
}

.summary-primary-btn,
.primary-btn {
  flex: 1;
  background: #DFFFDF;
  color: #5E4E3E;
}

.summary-secondary-btn,
.secondary-btn {
  width: 180rpx;
  background: #fff;
  color: #5E4E3E;
}

.category-highlight {
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFF3CD;
  border: 3rpx solid rgba(94, 78, 62, 0.18);
}

.category-highlight-label {
  display: block;
  font-size: 20rpx;
  color: #8B7E74;
  font-weight: 700;
}

.category-highlight-name {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #5E4E3E;
  font-weight: 900;
}

.category-highlight-amount {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #FF9F43;
  font-weight: 900;
}

.category-stats-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.category-stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #F9F6F0;
}

.category-stat-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.category-stat-name {
  font-size: 24rpx;
  color: #5E4E3E;
  font-weight: 900;
}

.category-stat-count {
  font-size: 18rpx;
  color: #8B7E74;
  font-weight: 700;
}

.category-stat-amount {
  font-size: 24rpx;
  color: #5E4E3E;
  font-weight: 900;
}

.section-title-row {
  margin: 12rpx 0 16rpx;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: #8B7E74;
  font-size: 24rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  background: #fff;
  border: 3rpx solid #5E4E3E;
  border-radius: 24rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  padding: 24rpx;
}

.entry-amount {
  color: #FF9F43;
  font-size: 28rpx;
  font-weight: 900;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0;
}

.entry-tag,
.entry-invoice {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F5F0EA;
}

.entry-route {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin: 12rpx 0 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F9F6F0;
  border: 2rpx solid rgba(94, 78, 62, 0.12);
}

.route-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.route-label {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #8B7E74;
  font-weight: 900;
}

.route-value {
  min-width: 0;
  color: #5E4E3E;
  font-size: 22rpx;
  font-weight: 800;
  overflow-wrap: break-word;
}

.route-divider {
  width: 2rpx;
  height: 24rpx;
  background: rgba(94, 78, 62, 0.18);
}

.actions-only {
  justify-content: flex-end;
}

.entry-actions {
  display: flex;
  gap: 24rpx;
}

.entry-action {
  font-size: 22rpx;
  font-weight: 900;
}

.edit-action {
  color: #5E4E3E;
}

.delete-action {
  color: #FF6B6B;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(94, 78, 62, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  z-index: 999;
}

.modal-card {
  width: 100%;
  max-height: 90vh;
  background: #fff;
  border-radius: 36rpx;
  border: 4rpx solid #5E4E3E;
  box-shadow: 8rpx 8rpx 0 #5E4E3E;
  overflow: hidden;
}

.modal-header {
  background: #FFF3CD;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 3rpx solid #5E4E3E;
}

.modal-title,
.modal-close {
  color: #5E4E3E;
}

.modal-close {
  font-size: 32rpx;
  font-weight: 900;
}

.modal-body {
  padding: 28rpx 28rpx 0;
  max-height: 65vh;
  overflow-y: auto;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.form-group {
  margin-bottom: 20rpx;
  min-width: 0;
}

.half {
  flex: 1;
  min-width: 0;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.project-loading,
.project-empty {
  color: #8B7E74;
  font-size: 20rpx;
  font-weight: 700;
}

.project-empty {
  display: block;
  margin-top: 12rpx;
}

.project-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.project-option {
  max-width: 100%;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(94, 78, 62, 0.24);
  background: #FFF3CD;
  color: #5E4E3E;
  font-size: 22rpx;
  font-weight: 900;
  overflow-wrap: break-word;
}

.form-input,
.form-picker,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #F5F0EA;
  border: 4rpx solid rgba(94, 78, 62, 0.3);
  border-radius: 24rpx;
  padding: 24rpx;
  color: #5E4E3E;
  font-size: 28rpx;
  line-height: 1.6;
}

.form-input {
  min-height: 88rpx;
}

.form-picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.form-textarea {
  min-height: 160rpx;
}

.field-placeholder {
  color: #C0B5AE;
}

.modal-footer {
  gap: 16rpx;
  padding: 24rpx 28rpx 28rpx;
}
