<wxs module="durationUnit">
function hours(minutes) {
  var value = (minutes || 0) / 60;
  return Math.round(value * 100) / 100;
}
function optionalHours(minutes) {
  if (minutes === null || minutes === undefined || minutes === '') return '';
  return hours(minutes);
}
module.exports = { hours: hours, optionalHours: optionalHours };
</wxs>

<view class="page">
  <view class="hero">
    <view>
      <text class="title">考勤与工资规则</text>
      <text class="subtitle">只计算税前工资，规则由你自己维护</text>
    </view>
    <view class="status">{{ruleStatusText}}<text wx:if="{{meta.version}}"> · v{{meta.version}}</text></view>
  </view>

  <view class="panel load-state" wx:if="{{loading}}"><text>正在读取规则...</text></view>
  <view class="panel load-state error-state" wx:if="{{!loading && !document}}">
    <text class="panel-title">规则暂时无法加载</text>
    <text class="hint">{{loadError || '请检查网络连接后重试'}}</text>
    <button class="secondary add-item" bindtap="loadRule">重新加载</button>
  </view>

  <view class="panel quick-setup" wx:if="{{!loading && document && quickSetupVisible}}">
    <view class="quick-setup-heading">
      <view>
        <text class="quick-setup-eyebrow">快速开始</text>
        <text class="panel-title">选择一种常用考勤方案</text>
        <text class="section-help">方案只会生成班次和每周安排，不会改动你的工资、补贴和加班单价。生成后仍需检查并发布。</text>
      </view>
      <view class="quick-setup-state">{{meta.setup_state === 'draft_unpublished' ? '已有未发布草稿' : '尚未配置'}}</view>
    </view>
    <view class="plan-grid">
      <view class="plan-card {{selectedPlanKey === item.key ? 'plan-card-selected' : ''}}" wx:for="{{attendancePlanOptions}}" wx:key="key">
        <view class="plan-card-head">
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-recommended" wx:if="{{item.recommended}}">推荐</text>
        </view>
        <text class="plan-description">{{item.description}}</text>
        <text class="plan-summary">{{item.summary}}</text>
        <button class="plan-action" data-key="{{item.key}}" loading="{{applyingPlanKey === item.key}}" disabled="{{applyingPlanKey || selectedPlanKey === item.key}}" bindtap="applyAttendancePlan">{{selectedPlanKey === item.key ? '已生成草稿' : '使用此方案'}}</button>
      </view>
    </view>
    <view class="plan-ready" wx:if="{{quickSetupApplied}}">
      <view class="plan-ready-copy"><text class="plan-ready-title">基础考勤已配置</text><text class="plan-ready-desc">接下来检查加班、工资和试算结果，然后确认发布时间。</text></view>
      <button class="primary plan-ready-action" bindtap="goToPublishStep">检查并发布</button>
    </view>
  </view>

  <view class="wizard-shell" wx:if="{{!loading && document}}">
    <view class="wizard-summary"><view><text class="wizard-eyebrow">步骤 {{currentStep + 1}} / {{wizardSteps.length}}</text><text class="wizard-title">{{currentStepTitle}}</text><text class="wizard-description">{{currentStepDescription}}</text></view><button class="guide-replay" bindtap="replayStepGuide">查看本步引导</button></view>
    <scroll-view class="wizard-steps" scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation="{{true}}" scroll-into-view="{{wizardScrollIntoView}}"><view class="wizard-step-row"><view wx:for="{{wizardSteps}}" wx:key="key" id="wizard-step-{{index}}" class="wizard-step {{currentStep === index ? 'wizard-step-active' : ''}} {{currentStep > index ? 'wizard-step-done' : ''}}" data-index="{{index}}" bindtap="onWizardStepTap"><text class="wizard-step-number">{{currentStep > index ? '✓' : index + 1}}</text><text>{{item.title}}</text></view></view></scroll-view>
  </view>

  <view class="panel" wx:if="{{!loading && document && currentStep === 0}}">
    <view class="panel-title">你平时怎么上班？</view>
    <text class="section-help">公司上班和出差可以分别回答，后面的加班计算也会分别使用。</text>
    <view id="guide-sceneTabs" class="scene-tabs guide-target {{guideOpen && guideItem.target === 'sceneTabs' ? 'guide-target-active' : ''}}" role="tablist" aria-label="考勤场景">
      <view wx:for="{{scenes}}" wx:key="key" role="tab" aria-selected="{{selectedScene === item.key}}" class="scene-tab {{selectedScene === item.key ? 'scene-tab-active' : ''}}" data-scene="{{item.key}}" bindtap="onSceneTab"><text>{{item.label}}</text><text wx:if="{{sceneStatuses[item.key]}}" class="attention-dot" aria-label="尚未完成">!</text></view>
    </view>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'sceneTabs'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <view class="setting-block">
      <text class="setting-label">你的上下班时间固定吗？</text>
      <view class="mode-segments compact-segments" role="tablist" aria-label="工时制度"><view wx:for="{{attendanceModeOptions}}" wx:key="value" class="mode-segment {{document.attendance.scenes[selectedScene].mode === item.value ? 'mode-segment-active' : ''}}" data-mode="{{item.value}}" bindtap="onSceneModeTab">{{item.label}}</view></view>
    </view>
    <view id="guide-standardHours" class="row emphasis-row guide-target {{guideOpen && guideItem.target === 'standardHours' ? 'guide-target-active' : ''}}"><text>你一天通常工作多久？</text><input type="digit" value="{{document.attendance.scenes[selectedScene].standard_minutes / 60}}" bindinput="onSceneNumberInput" /><text>小时</text></view>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'standardHours'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <button class="advanced-toggle" data-section="basics" bindtap="toggleAdvanced"><text>{{advancedOpen.basics ? '收起更多选项' : '还有其他情况？'}}</text><text class="advanced-toggle-note">{{advancedOpen.basics ? '' : '工时怎么统计、缺卡怎么办'}}</text></button>
    <view class="advanced-block" wx:if="{{advancedOpen.basics}}">
    <block wx:if="{{document.attendance.scenes[selectedScene].mode === 'flexible'}}">
      <picker mode="selector" range="{{flexibleMetricOptions}}" range-key="label" data-field="flexible_metric" bindchange="onScenePicker"><view class="picker">一天有多次打卡时，工时怎么算？{{document.attendance.scenes[selectedScene].flexible_metric === 'first_last_span' ? '从第一次算到最后一次' : '把每段时间加起来'}} <text>›</text></view></picker>
      <picker mode="selector" range="{{shortfallPolicyOptions}}" range-key="label" data-field="shortfall_policy" bindchange="onScenePicker"><view class="picker">当天不足标准工时时怎么办？{{document.attendance.scenes[selectedScene].shortfall_policy === 'normal' ? '仍按正常上班' : '不提醒早退'}} <text>›</text></view></picker>
    </block>
    <picker mode="selector" range="{{missingPunchPolicyOptions}}" range-key="label" data-field="missing_punch_policy" bindchange="onScenePicker"><view class="picker">缺卡处理：{{document.attendance.scenes[selectedScene].missing_punch_policy === 'ignore' ? '忽略缺卡' : '标记待补卡'}} <text>›</text></view></picker>
    <picker mode="selector" range="{{shiftTemplateOptions}}" range-key="label" bindchange="onSceneDefaultShift"><view class="picker">未单独排班时：{{document.attendance.scenes[selectedScene].default_shift_template ? document.attendance.shift_templates[document.attendance.scenes[selectedScene].default_shift_template].name : '沿用本场景时间'}} <text>›</text></view></picker>
    </view>
    <view class="subsection" wx:if="{{document.attendance.scenes[selectedScene].mode === 'fixed'}}">
      <view class="subsection-head"><view><text>你通常几点上班、几点下班？</text><text class="subsection-note">上班和下班时间都由你直接选择</text></view><button class="tiny" wx:if="{{advancedOpen.basics}}" bindtap="addWorkPeriod">添加特殊时段</button></view>
      <block wx:for="{{document.attendance.scenes[selectedScene].normal_work_periods}}" wx:key="id">
      <view class="config-item" wx:if="{{index === 0 || advancedOpen.basics}}">
        <view class="item-head" wx:if="{{index > 0}}"><input class="item-name" data-index="{{index}}" value="{{item.name}}" bindinput="onWorkPeriodInput" placeholder="特殊时段名称" /><button class="tiny danger" data-index="{{index}}" bindtap="removeWorkPeriod">删除</button></view>
        <view id="{{index === 0 ? 'guide-primaryStart' : ''}}" class="time-flow guide-target {{guideOpen && guideItem.target === 'primaryStart' && index === 0 ? 'guide-target-active' : ''}}"><view class="time-field"><text>上班时间</text><picker mode="time" value="{{item.start_text}}" data-index="{{index}}" data-field="start_minute" bindchange="onWorkPeriodTime"><view class="picker compact">{{item.start_text}} <text>›</text></view></picker></view><text class="time-arrow">→</text><view class="time-field"><text>下班时间{{item.ends_next_day ? '（次日）' : ''}}</text><picker mode="time" value="{{item.end_text}}" data-index="{{index}}" data-field="end_minute" bindchange="onWorkPeriodTime"><view class="picker compact">{{item.end_text}} <text>›</text></view></picker></view></view>
        <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'primaryStart' && index === 0}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
        <view class="switch-row"><text>下班是在第二天</text><switch checked="{{item.ends_next_day}}" data-index="{{index}}" bindchange="onWorkPeriodNextDay" color="#4ECDC4" /></view>
      </view>
      </block>
      <text class="hint">如果中间有午休或分段工作，直接添加第二段时间；不用再单独填写休息时长。</text>
    </view>
  </view>

  <view id="guide-shiftTemplates" class="panel guide-target {{guideOpen && guideItem.target === 'shiftTemplates' ? 'guide-target-active' : ''}}" wx:if="{{!loading && document && currentStep === 1}}">
    <view class="panel-title">每周安排</view>
    <text class="section-help">一般只需选单休或双休，系统会直接使用第一步的上下班时间。只有多班次、倒班或特殊时间时，才需要添加特殊班次。</text>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'shiftTemplates'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <button class="advanced-toggle" bindtap="toggleShiftTemplates"><text>{{shiftTemplatesOpen ? '收起特殊班次' : '有多班次或特殊时间？'}}</text><text class="advanced-toggle-note">{{shiftTemplatesOpen ? '' : '按需添加，一般不用设置'}}</text></button>
    <view class="advanced-block" wx:if="{{shiftTemplatesOpen}}">
    <view class="subsection-head"><view><text>特殊班次</text><text class="subsection-note">多班次或特殊时间才需要</text></view><button class="tiny" bindtap="addShiftTemplate">添加特殊班次</button></view>
    <text class="hint" wx:if="{{!shiftTemplates.length}}">暂无特殊班次。选择下方的单休或双休后，系统会自动建立默认工作班次。</text>
    <view class="config-item shift-template" wx:for="{{shiftTemplates}}" wx:key="id" wx:for-item="shift">
      <view class="item-head"><input class="item-name" data-id="{{shift.id}}" data-field="name" value="{{shift.name}}" bindinput="onShiftTemplateInput" placeholder="班次名称" /><button class="tiny danger" data-id="{{shift.id}}" bindtap="removeShiftTemplate">删除</button></view>
      <view class="labeled-control shift-scope-control"><text>使用范围</text><picker mode="selector" range="{{shiftScopeOptions}}" range-key="label" value="{{shift.sceneIndex}}" data-id="{{shift.id}}" data-field="scene" bindchange="onShiftTemplatePicker"><view class="picker compact">{{shift.sceneLabel}} <text>›</text></view></picker></view>
      <view class="inheritance-note"><text class="inheritance-title">工作时长和上下班时间</text><text>当前班次的时间已独立保存。只有它和第一步不同时，才需要展开修改。</text><button class="tiny detail-toggle" data-id="{{shift.id}}" bindtap="toggleShiftDetails">{{shiftDetailsOpen[shift.id] ? '收起特殊班次设置' : '需要特殊时间？展开修改'}}</button></view>
      <view wx:if="{{shiftDetailsOpen[shift.id]}}" class="shift-detail-editor"><picker mode="selector" range="{{attendanceModeOptions}}" range-key="label" value="{{shift.mode === 'flexible' ? 1 : 0}}" data-id="{{shift.id}}" data-field="mode" bindchange="onShiftTemplatePicker"><view class="picker">这个班次的工时制度：{{shift.mode === 'flexible' ? '自由工时' : '固定时间'}} <text>›</text></view></picker><view class="row"><text>这个班次每天工作多久？</text><input type="digit" data-id="{{shift.id}}" data-field="standard_minutes" value="{{shift.standard_minutes / 60}}" bindinput="onShiftTemplateInput" /><text>小时</text></view>
      <block wx:if="{{shift.mode === 'fixed'}}">
        <view class="subsection-head compact-head"><view><text>这班几点上班、几点下班？</text><text class="subsection-note">两个时间都由你直接选择</text></view><button class="tiny" data-id="{{shift.id}}" bindtap="addTemplatePeriod">添加特殊时段</button></view>
        <view class="period-row" wx:for="{{shift.normal_work_periods}}" wx:key="id" wx:for-item="period" wx:for-index="periodIndex">
          <view class="item-head" wx:if="{{periodIndex > 0}}"><input class="item-name" data-id="{{shift.id}}" data-index="{{periodIndex}}" value="{{period.name}}" bindinput="onTemplatePeriodInput" placeholder="特殊时段名称" /><button class="tiny danger" data-id="{{shift.id}}" data-index="{{periodIndex}}" bindtap="removeTemplatePeriod">删除</button></view>
          <view class="time-flow"><view class="time-field"><text>上班时间</text><picker mode="time" value="{{period.start_text}}" data-id="{{shift.id}}" data-index="{{periodIndex}}" data-field="start_minute" bindchange="onTemplatePeriodTime"><view class="picker compact">{{period.start_text}} <text>›</text></view></picker></view><text class="time-arrow">→</text><view class="time-field"><text>下班时间{{period.ends_next_day ? '（次日）' : ''}}</text><picker mode="time" value="{{period.end_text}}" data-id="{{shift.id}}" data-index="{{periodIndex}}" data-field="end_minute" bindchange="onTemplatePeriodTime"><view class="picker compact">{{period.end_text}} <text>›</text></view></picker></view></view>
          <view class="switch-row"><text>下班是在第二天</text><switch checked="{{period.ends_next_day}}" data-id="{{shift.id}}" data-index="{{periodIndex}}" bindchange="onTemplatePeriodNextDay" color="#4ECDC4" /></view>
        </view>
      </block>
      </view>
    </view>
    </view>

    <view id="guide-weeklySchedule" class="subsection guide-target {{guideOpen && guideItem.target === 'weeklySchedule' ? 'guide-target-active' : ''}}">
      <view class="subsection-head"><view><text>每周排班</text><text class="subsection-note">先选单休或双休，也可以再逐天修改</text></view></view>
      <view class="weekly-rest-control">
        <view class="weekly-rest-copy"><text class="weekly-rest-question">你每周休息几天？</text><text class="weekly-rest-help">选好后会自动安排工作日；没有班次时会按第一步自动创建</text></view>
        <view class="mode-segments weekly-rest-segments" role="tablist" aria-label="每周休息安排"><view wx:for="{{weeklyRestModeOptions}}" wx:key="value" class="mode-segment {{weeklyRestMode === item.value ? 'mode-segment-active' : ''}}" data-mode="{{item.value}}" bindtap="onWeeklyRestModeChange">{{item.label}}</view></view>
      </view>
      <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'weeklySchedule'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
      <view class="schedule-row" wx:for="{{weeklyRows}}" wx:key="key">
        <text>{{item.label}}</text><picker mode="selector" range="{{shiftTemplateOptions}}" range-key="label" value="{{item.templateIndex}}" data-index="{{index}}" bindchange="onWeeklyTemplate"><view class="picker compact">{{item.templateLabel}} <text>›</text></view></picker>
      </view>
    </view>

    <button class="advanced-toggle" data-section="schedule" bindtap="toggleAdvanced"><text>{{advancedOpen.schedule ? '收起临时安排' : '某一天不一样？'}}</text><text class="advanced-toggle-note">{{advancedOpen.schedule ? '' : '单独修改某天的上班安排'}}</text></button>
    <view class="advanced-block" wx:if="{{advancedOpen.schedule}}">
    <view class="subsection">
      <view class="subsection-head"><text>单独修改某一天</text><button class="tiny" bindtap="addDayOverride">添加日期</button></view>
      <view class="config-item" wx:for="{{dayOverrides}}" wx:key="date">
        <view class="item-head"><picker mode="date" value="{{item.date}}" data-index="{{index}}" bindchange="onDayOverrideDate"><view class="picker compact">{{item.date}} <text>›</text></view></picker><button class="tiny danger" data-index="{{index}}" bindtap="removeDayOverride">删除</button></view>
        <picker mode="selector" range="{{shiftTemplateOptions}}" range-key="label" value="{{item.templateIndex}}" data-index="{{index}}" data-field="shift_template_id" bindchange="onDayOverridePicker"><view class="picker">班次：{{item.templateLabel}} <text>›</text></view></picker>
        <view class="rule-grid"><picker mode="selector" range="{{optionalScenes}}" range-key="label" value="{{item.sceneIndex}}" data-index="{{index}}" data-field="scene" bindchange="onDayOverridePicker"><view class="picker compact">场景：{{item.sceneLabel}} <text>›</text></view></picker><picker mode="selector" range="{{optionalAttendanceModes}}" range-key="label" value="{{item.modeIndex}}" data-index="{{index}}" data-field="mode" bindchange="onDayOverridePicker"><view class="picker compact">模式：{{item.modeLabel}} <text>›</text></view></picker></view>
        <picker mode="selector" range="{{optionalDayTypes}}" range-key="label" value="{{item.dayTypeIndex}}" data-index="{{index}}" data-field="day_type" bindchange="onDayOverridePicker"><view class="picker">日期类型：{{item.dayTypeLabel}} <text>›</text></view></picker>
      </view>
      <text class="hint">同一天只能单独设置一次。计算时，会先看你当天手动选择的是公司上班还是出差，再看这里的临时安排，然后才看每周安排和常用班次。</text>
    </view>
    </view>
  </view>

  <view class="panel" wx:if="{{!loading && document && currentStep === 2}}">
    <view class="panel-title">你要设置哪一种日子？</view>
    <view id="guide-dayTabs" class="day-tabs guide-target {{guideOpen && guideItem.target === 'dayTabs' ? 'guide-target-active' : ''}}" role="tablist" aria-label="日期类型"><view wx:for="{{dayTypes}}" wx:key="key" role="tab" aria-selected="{{selectedDayType === item.key}}" class="day-tab {{selectedDayType === item.key ? 'day-tab-active' : ''}}" data-day-type="{{item.key}}" bindtap="onDayTypeTab"><text>{{item.label}}</text><text wx:if="{{dayRuleStatuses[item.key]}}" class="attention-dot" aria-label="尚未完成">!</text></view></view>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'dayTabs'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <text class="hint">工作日、休息日和法定节假日可以用不同的加班算法；日历上的节假日标签会优先使用节假日规则。</text>
  </view>

  <view id="guide-deductionRules" class="panel guide-target {{guideOpen && guideItem.target === 'deductionRules' ? 'guide-target-active' : ''}}" wx:if="{{!loading && document && currentStep === 2}}">
    <view class="panel-title">什么时候要扣掉休息时间？</view>
    <text class="section-help">不用填写午休时间。这里只看当天从上班打卡到下班打卡一共跨了多久，再按你的条件扣掉休息时长；不是看下班后又加班了多久。</text>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'deductionRules'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <view class="config-item" wx:for="{{document.day_rules[selectedDayType].deductions}}" wx:key="id">
      <view class="item-head"><text class="item-index">条件 {{index + 1}}</text><button class="tiny danger" data-index="{{index}}" bindtap="removeDeduction">删除</button></view>
      <view class="deduction-sentence"><text>当</text><picker mode="selector" range="{{deductionMetricOptions}}" range-key="label" data-index="{{index}}" data-field="metric" bindchange="onDeductionPicker"><view class="sentence-choice">{{item.metric === 'attendance_span' ? '当天从上班打卡到下班打卡' : '当天加班本身'}} <text>›</text></view></picker><picker mode="selector" range="{{operatorOptions}}" data-index="{{index}}" data-field="operator" bindchange="onDeductionPicker"><view class="sentence-choice">{{item.operator === '<=' ? '不超过' : (item.operator === '>' ? '超过' : (item.operator === '>=' ? '不少于' : (item.operator === '<' ? '少于' : '等于')))}} <text>›</text></view></picker><view class="inline-number"><input type="digit" data-index="{{index}}" data-field="threshold_minutes" value="{{item.threshold_minutes / 60}}" bindinput="onDeductionHoursInput" /><text>小时</text></view><text>时，扣掉</text><view class="inline-number"><input type="digit" data-index="{{index}}" data-field="deduct_minutes" value="{{item.deduct_minutes / 60}}" bindinput="onDeductionHoursInput" /><text>小时休息</text></view></view>
    </view>
    <button class="secondary add-item" bindtap="addDeduction">添加扣除规则</button>
    <text class="hint">如果同一天碰到多条条件，只按你排在最前面的那条来算。</text>
  </view>

