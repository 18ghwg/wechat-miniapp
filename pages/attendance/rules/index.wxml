        <button class="formula-add" data-target="item_amount" data-owner-index="{{salaryIndex}}" bindtap="addFormulaStep">添加运算步骤</button>
      </view>
      <picker mode="selector" range="{{quantitySourceOptions}}" range-key="label" data-index="{{salaryIndex}}" data-field="quantity_source" bindchange="onItemPicker"><view class="picker question-picker"><text class="picker-question">这个项目按多少来算？</text><view class="picker-answer"><text>{{salaryItem.quantity_source === 'automatic' ? '按打卡记录自动统计' : (salaryItem.quantity_source === 'formula' ? '按我选择的条件计算' : '我自己填写数量')}}</text><text class="picker-chevron">›</text></view></view></picker>
      <view class="row" wx:if="{{salaryItem.quantity_source === 'manual'}}"><text>数量</text><input type="digit" data-index="{{salaryIndex}}" data-field="manual_quantity" value="{{salaryItem.manual_quantity}}" bindinput="onItemInput" /><text>{{salaryItem.unit_label}}</text></view>
      <picker wx:if="{{salaryItem.quantity_source === 'automatic'}}" mode="selector" range="{{quantityVariableOptions}}" range-key="label" data-index="{{salaryIndex}}" data-field="quantity_variable" bindchange="onItemPicker"><view class="picker question-picker"><text class="picker-question">你希望按哪种记录统计？</text><view class="picker-answer"><text>{{salaryItem.quantity_variable_label}}</text><text class="picker-chevron">›</text></view></view></picker>
      <view wx:if="{{salaryItem.quantity_source === 'formula'}}" class="formula-box">
        <picker mode="selector" range="{{formulaVariableOptions}}" range-key="label" data-target="item_quantity" data-owner-index="{{salaryIndex}}" bindchange="onFormulaStartPicker"><view class="picker question-picker"><text class="picker-question">先从哪项数据开始算？</text><view class="picker-answer"><text>{{salaryItem.quantity_formula.start_label}}</text><text class="picker-chevron">›</text></view></view></picker>
        <view class="formula-step" wx:for="{{salaryItem.quantity_formula.steps}}" wx:for-item="step" wx:for-index="stepIndex">
          <picker mode="selector" range="{{formulaOperatorOptions}}" data-target="item_quantity" data-owner-index="{{salaryIndex}}" data-step-index="{{stepIndex}}" data-field="operator" bindchange="onFormulaStepPicker"><view class="picker compact">{{step.operator}} <text>›</text></view></picker>
          <picker mode="selector" range="{{formulaOperandOptions}}" range-key="label" data-target="item_quantity" data-owner-index="{{salaryIndex}}" data-step-index="{{stepIndex}}" data-field="operand_kind" bindchange="onFormulaStepPicker"><view class="picker compact">{{step.operand_kind_label}} <text>›</text></view></picker>
          <picker wx:if="{{step.operand.kind === 'variable'}}" mode="selector" range="{{formulaVariableOptions}}" range-key="label" data-target="item_quantity" data-owner-index="{{salaryIndex}}" data-step-index="{{stepIndex}}" data-field="operand_variable" bindchange="onFormulaStepPicker"><view class="picker formula-value">{{step.operand_label}} <text>›</text></view></picker>
          <input wx:else class="formula-value" type="digit" value="{{step.operand.value}}" data-target="item_quantity" data-owner-index="{{salaryIndex}}" data-step-index="{{stepIndex}}" bindinput="onFormulaStepNumber" />
          <button class="icon-button danger" aria-label="删除公式步骤" data-target="item_quantity" data-owner-index="{{salaryIndex}}" data-step-index="{{stepIndex}}" bindtap="removeFormulaStep">×</button>
        </view>
        <button class="formula-add" data-target="item_quantity" data-owner-index="{{salaryIndex}}" bindtap="addFormulaStep">添加运算步骤</button>
      </view>
      <view class="row"><text>从哪天开始算？</text><picker mode="date" data-index="{{salaryIndex}}" data-field="effective_from" value="{{salaryItem.effective_from}}" bindchange="onItemPicker"><view class="picker compact">{{salaryItem.effective_from || '选择日期'}}</view></picker></view>
      <view class="row"><text>哪天之后不再算？</text><picker mode="date" data-index="{{salaryIndex}}" data-field="effective_to" value="{{salaryItem.effective_to}}" bindchange="onItemPicker"><view class="picker compact">{{salaryItem.effective_to || '一直有效'}}</view></picker><button wx:if="{{salaryItem.effective_to}}" class="tiny" data-index="{{salaryIndex}}" bindtap="clearItemEndDate">清除</button></view>
      <view class="switch-row"><text>计入税前工资</text><switch checked="{{salaryItem.include_in_pretax}}" data-index="{{salaryIndex}}" data-field="include_in_pretax" bindchange="onItemSwitch" color="#4ECDC4" /></view>
      <view class="switch-row"><text>计入加班工资基数</text><switch checked="{{salaryItem.include_in_overtime_base}}" data-index="{{salaryIndex}}" data-field="include_in_overtime_base" bindchange="onItemSwitch" color="#4ECDC4" /></view>
    </view>
	<button class="secondary add-item" bindtap="addCustomItem">添加自定义工资项目</button>
    <text class="hint">岗位津贴可以按月，餐补和出差补助可以按天；特殊津贴也可以选择系统提供的条件来计算。</text>
	</view>
  </view>

  <view id="guide-preview" class="panel preview-panel guide-target {{guideOpen && guideItem.target === 'preview' ? 'guide-target-active' : ''}}" wx:if="{{!loading && document && currentStep === 4}}">
    <view class="panel-title">这样算出来对不对？</view>
    <view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'preview'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view>
    <view class="row"><text>预览日期</text><picker mode="date" value="{{previewDate}}" bindchange="onPreviewDate"><view class="picker compact">{{previewDate}}</view></picker></view>
    <view class="time-grid preview-times"><picker mode="time" value="{{previewAttendanceStart}}" data-field="previewAttendanceStart" bindchange="onPreviewTime"><view class="picker compact">上班 {{previewAttendanceStart}} <text>›</text></view></picker><picker mode="time" value="{{previewAttendanceEnd}}" data-field="previewAttendanceEnd" bindchange="onPreviewTime"><view class="picker compact">下班 {{previewAttendanceEnd}} <text>›</text></view></picker></view>
	<view class="switch-row"><text>下班打卡在次日</text><switch checked="{{previewAttendanceEndsNextDay}}" bindchange="onPreviewAttendanceNextDay" color="#4ECDC4" /></view>
	<view class="mode-segments" aria-label="试算加班来源"><view wx:for="{{previewOvertimeModes}}" wx:key="value" class="mode-segment {{previewOvertimeMode === item.value ? 'mode-segment-active' : ''}}" data-mode="{{item.value}}" bindtap="onPreviewOvertimeMode">{{item.label}}</view></view>
	<view class="subsection-head preview-session-head" wx:if="{{previewOvertimeMode === 'manual'}}"><text>试算加班场次</text><button class="tiny" bindtap="addPreviewSession">添加场次</button></view>
	<view class="config-item preview-session" wx:if="{{previewOvertimeMode === 'manual'}}" wx:for="{{previewSessions}}" wx:key="id">
      <view class="item-head"><text class="item-index">第 {{index + 1}} 场</text><button class="tiny danger" data-index="{{index}}" bindtap="removePreviewSession">删除</button></view>
      <view class="rule-grid"><picker mode="time" value="{{item.start}}" data-index="{{index}}" bindchange="onPreviewSessionTime"><view class="picker compact">开始 {{item.start}} <text>›</text></view></picker><view class="mini-field"><input type="digit" value="{{item.hours}}" data-index="{{index}}" bindinput="onPreviewSessionHours" /><text>时长（小时）</text></view></view>
    </view>
    <view class="row"><text>当月工作天数</text><input type="digit" data-field="previewWorkDays" value="{{previewWorkDays}}" bindinput="onPreviewVariable" /><text>天</text></view>
    <view class="row"><text>当月出差天数</text><input type="digit" data-field="previewTripDays" value="{{previewTripDays}}" bindinput="onPreviewVariable" /><text>天</text></view>
    <button class="secondary preview-button" loading="{{previewing}}" disabled="{{previewing}}" bindtap="previewRule">预览税前工资</button>
	<view class="result" wx:if="{{preview}}"><text class="preview-total">预计税前合计 {{previewPretax}} 元</text><text>考勤判定：{{preview.attendance_status_text}}</text><text>实际工时 {{durationUnit.hours(preview.actual_work_minutes)}} 小时 · 不足 {{durationUnit.hours(preview.shortfall_minutes)}} 小时</text><text>加班来源：{{preview.overtime_source_text}}</text><text>首末打卡跨度 {{durationUnit.hours(preview.attendance_span_minutes)}} 小时</text><text>原始加班 {{durationUnit.hours(preview.raw_minutes)}} 小时 · 扣休 {{durationUnit.hours(preview.deduction_minutes)}} 小时</text><text>认可加班 {{durationUnit.hours(preview.recognized_minutes)}} 小时 · 计薪 {{durationUnit.hours(preview.paid_minutes)}} 小时</text><text>转调休 {{durationUnit.hours(preview.comp_minutes)}} 小时 · 获得调休 {{durationUnit.hours(preview.comp_credit_minutes)}} 小时</text><text>加班费 {{previewAmount}} 元</text><text wx:for="{{preview.salary_items}}" wx:key="id">{{item.name}}：{{item.quantity}} {{item.unit_label}} · {{item.amount_text}} 元</text><text class="warning-text" wx:for="{{preview.warnings}}" wx:key="*this">{{item}}</text><text class="hint" wx:if="{{!preview.warnings || !preview.warnings.length}}">未发现重叠或空档问题</text></view>
  </view>

  <view class="validation" wx:if="{{currentStep === 4 && validation && !validation.valid}}"><text wx:for="{{validation.issues}}" wx:key="path">{{item.message}}</text></view>
  <view class="validation ok" wx:if="{{currentStep === 4 && validation && validation.valid}}">我检查过了，这套规则可以正常使用。</view>

  <view id="guide-publish" class="panel guide-target {{guideOpen && guideItem.target === 'publish' ? 'guide-target-active' : ''}}" wx:if="{{!loading && document && currentStep === 4}}"><view class="panel-title">从哪个月开始用这套规则？</view><view class="coach-inline" wx:if="{{guideOpen && guideItem.target === 'publish'}}"><text class="coach-progress">引导 {{guideIndex + 1}} / {{guideCount}}</text><text class="coach-title">{{guideItem.title}}</text><text class="coach-body">{{guideItem.body}}</text><view class="coach-actions"><button class="coach-skip" bindtap="skipGuide">跳过</button><button class="coach-next" bindtap="nextGuide">{{guideIndex + 1 >= guideCount ? '知道了' : '下一条'}}</button></view></view><view class="row"><text>规则从哪个月生效？</text><picker mode="selector" range="{{effectiveMonthOptions}}" range-key="label" value="{{effectiveMonthIndex}}" bindchange="onEffectiveMonth"><view class="picker compact">{{effectiveMonthOptions[effectiveMonthIndex].label}} <text>›</text></view></picker></view><text class="hint">本月生效会按新规则重算本月全部考勤；下月生效则从下月 1 日开始。历史工资快照不会自动改写。</text></view>
  <view class="actions" wx:if="{{!loading && document && currentStep === 4}}"><button class="secondary" loading="{{saving}}" disabled="{{saving || publishing}}" bindtap="saveDraft">先保存，稍后再用</button><button class="secondary" loading="{{validating}}" disabled="{{validating || saving || publishing}}" bindtap="validateRule">帮我检查一下</button><button class="secondary" loading="{{historyLoading}}" disabled="{{historyLoading || publishing}}" bindtap="openHistory">看看以前的版本</button><button class="primary" loading="{{publishing}}" disabled="{{publishing || saving || validating}}" bindtap="publishRule">从这天开始使用</button></view>

  <view class="wizard-footer" wx:if="{{!loading && document}}"><button class="wizard-back" wx:if="{{currentStep > 0}}" bindtap="previousWizardStep">上一步</button><view class="wizard-footer-spacer"></view><button class="wizard-next" wx:if="{{currentStep < wizardSteps.length - 1}}" bindtap="nextWizardStep">下一步：{{wizardSteps[currentStep + 1].title}}</button></view>

	<view class="mask" wx:if="{{showHistory}}" bindtap="closeHistory"><view class="history" catchtap="noop"><view class="panel-title">以前用过的规则</view><view class="history-item" wx:for="{{versions}}" wx:key="id"><view><text>第 {{item.version}} 版 · {{item.status}}</text><text class="hint">使用时间：{{item.effective_from || '还没开始使用'}} 至 {{item.effective_to || '一直有效'}}</text><text class="hint">{{item.updated_at || item.created_at || ''}}</text></view><view class="history-actions"><button class="tiny" data-version="{{item.version}}" bindtap="viewHistoryVersion">看看内容</button><button class="tiny" data-version="{{item.version}}" loading="{{restoringVersion === item.version}}" disabled="{{restoringVersion > 0}}" bindtap="restoreVersion">用回这版</button></view></view><view class="history-preview" wx:if="{{historyPreview}}"><text class="history-preview-title">第 {{historyPreview.version}} 版规则</text><text>使用时间：{{historyPreview.effectiveText}}</text><text>月基本工资：{{historyPreview.baseSalaryText}} 元</text><text>公司上班：{{historyPreview.companyText}}</text><text>出差：{{historyPreview.tripText}}</text><text>常用班次 {{historyPreview.shiftCount}} 个 · 单独修改日期 {{historyPreview.overrideCount}} 天 · 工资项目 {{historyPreview.salaryItemCount}} 个</text><view class="history-rule" wx:for="{{historyPreview.dayRules}}" wx:key="key"><text>{{item.label}}：加班至少 {{item.minimumText}} 才算</text><text>休息扣除 {{item.deductionCount}} 条 · 不同单价 {{item.bandCount}} 段</text><text>一天最多 {{item.dailyCapText}} · 一个月最多 {{item.monthlyCapText}}</text></view></view><button class="secondary" disabled="{{restoringVersion > 0}}" bindtap="closeHistory">关闭</button></view></view>

</view>
