/* 工资条配置页面样式 - Macaron Theme */
@import '/style/macaron-theme.wxss';

page {
  background: var(--background);
}

.company-verification-inline {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 8rpx;
}

.company-verification-question {
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.company-verification-input {
  min-height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--input-background);
  color: var(--foreground);
  font-size: 28rpx;
}

.company-verification-error {
  color: #B42318;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.company-verification-btn {
  width: 100%;
  min-height: 88rpx;
  margin: 8rpx 0 0;
  padding: 0 24rpx;
  border: 4rpx solid var(--foreground);
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 var(--foreground);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-peach-macaron);
  color: var(--foreground);
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.company-verification-btn::after {
  border: 0;
}

.company-verification-btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 var(--foreground);
}

.salary-config-container {
  min-height: 100vh;
  padding: 0 30rpx 40rpx;
  background: var(--background);
}

.page-header {
  padding: 40rpx 0 30rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: var(--color-yellow-macaron);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 4rpx solid var(--foreground);
  box-shadow: 6rpx 6rpx 0rpx var(--foreground);
}

.header-icon {
  width: 56rpx;
  height: 56rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted-foreground);
}

.profile-card,
.selector-card,
.form-card,
.help-card {
  margin-bottom: 28rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.profile-desc {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

.profile-badges {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.section-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 22rpx;
}

.section-header-compact {
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.section-subtitle {
  font-size: 22rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.form-picker-macaron {
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border: 4rpx solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.15s ease;
}

.form-picker-macaron:active {
  transform: scale(0.99);
}

.selected-status-card {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 3rpx dashed rgba(94, 78, 62, 0.16);
  border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.72);
}

.selected-status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.selected-status-name {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.selected-status-desc,
.selected-status-time,
.user-status-desc,
.user-status-time {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted-foreground);
}

.selected-status-time,
.user-status-time {
  margin-top: 8rpx;
}

.user-status-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.user-status-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-lg);
  border: 3rpx solid rgba(94, 78, 62, 0.12);
  background: rgba(255, 255, 255, 0.76);
}

.user-status-item-active {
  border-color: var(--foreground);
  box-shadow: 6rpx 6rpx 0rpx rgba(94, 78, 62, 0.14);
}

.user-status-main {
  flex: 1;
  min-width: 0;
}

.user-status-name {
  display: block;
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.selected-status-badge,
.user-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 128rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--foreground);
  border: 2rpx solid rgba(94, 78, 62, 0.14);
  background: rgba(255, 243, 205, 0.9);
  box-sizing: border-box;
}

.status-badge-text {
  display: block;
  font-size: 22rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1.2;
  text-align: center;
}

.selected-status-badge-manual,
.user-status-badge-manual {
  background: rgba(255, 214, 229, 0.92);
}

.selected-status-badge-auto,
.user-status-badge-auto {
  background: rgba(207, 245, 231, 0.92);
}

.selected-status-badge-pending,
.user-status-badge-pending {
  background: rgba(255, 243, 205, 0.92);
}

.selected-status-badge-normal,
.user-status-badge-normal {
  background: rgba(214, 234, 248, 0.92);
}

.picker-value {
  font-size: 28rpx;
  color: var(--foreground);
  font-weight: var(--font-weight-medium);
}

.picker-arrow {
  font-size: 40rpx;
  color: var(--muted-foreground);
  line-height: 1;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 40rpx;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(94, 78, 62, 0.16);
  border-top: 4rpx solid var(--color-peach-macaron);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--muted-foreground);
}

.form-content {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.form-helper {
  font-size: 22rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.input-disabled {
  background: var(--input-background);
  color: var(--muted-foreground);
}

.switch-group {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.macaron-switch {
  transform: scale(1.05);
  flex-shrink: 0;
}

.divider-line {
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(94, 78, 62, 0.08);
  margin: 6rpx 0 2rpx;
}

.action-section {
  margin-bottom: 28rpx;
}

.record-entry-card {
  margin-bottom: 28rpx;
  overflow: hidden;
}

.record-entry-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 30rpx;
}

.record-entry-main:active {
  background: var(--muted);
}

.record-entry-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.record-entry-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-blue-macaron);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-entry-icon {
  width: 36rpx;
  height: 36rpx;
}

.record-entry-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.record-entry-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.record-entry-desc {
  font-size: 24rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.record-entry-arrow {
  font-size: 40rpx;
  color: var(--muted-foreground);
  flex-shrink: 0;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  min-height: 88rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tip-item {
  font-size: 24rpx;
  color: var(--foreground);
  line-height: 1.6;
}
