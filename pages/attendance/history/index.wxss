.history-container {
  padding: 32rpx 32rpx 0;
  background: var(--background, #FFF8F0);
  min-height: 100vh;
}

.history-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.header-back-btn,
.header-export-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 4rpx solid #5E4E3E;
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  flex-shrink: 0;
}

.header-back-btn:active,
.header-export-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

.header-export-btn { background: #B5EAD7; }
.header-icon { width: 44rpx; height: 44rpx; }

.header-title {
  flex: 1;
  font-size: 44rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.filter-card {
  background: #fff;
  border: 4rpx solid #5E4E3E;
  border-radius: 32rpx;
  box-shadow: 6rpx 6rpx 0 #5E4E3E;
  padding: 36rpx;
  margin-bottom: 32rpx;
}

.filter-card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.filter-title-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.filter-card-title { font-size: 30rpx; font-weight: 900; color: #5E4E3E; }
.employee-row { margin-bottom: 20rpx; }

.employee-selector-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F9FAFB;
  border: 3rpx solid #5E4E3E;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.employee-selector-text { flex: 1; font-size: 26rpx; font-weight: 700; color: #5E4E3E; }
.selector-chevron { font-size: 20rpx; color: #8B7E74; }
.filter-inputs-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }

.filter-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #F9FAFB;
  border: 3rpx solid #5E4E3E;
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
  overflow: hidden;
}

.input-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.filter-input { flex: 1; font-size: 24rpx; font-weight: 700; color: #5E4E3E; min-width: 0; }
.filter-input-text { flex: 1; font-size: 24rpx; font-weight: 700; color: #5E4E3E; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-date-wrap { gap: 8rpx; }
.month-picker { flex: 1; min-width: 0; }
.picker-text { font-size: 24rpx; font-weight: 700; color: #5E4E3E; }
.filter-actions-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }

.filter-query-btn,
.filter-reset-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
  border: 3rpx solid #5E4E3E;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
}

.filter-query-btn { background: #FFCBA4; color: #5E4E3E; }
.filter-reset-btn { background: #B5EAD7; color: #5E4E3E; }

.filter-query-btn:active,
.filter-reset-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 #5E4E3E;
}

.stats-strip { display: flex; gap: 12rpx; }

.stats-strip-item {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stats-orange { background: #FFF3E0; border: 2rpx solid #FFCC80; }
.stats-blue { background: #E3F2FD; border: 2rpx solid #90CAF9; }
.stats-mint { background: #E8F5E9; border: 2rpx solid #A5D6A7; }
.stats-green { background: #E8F8E5; border: 2rpx solid #81C784; }
.stats-strip-label { font-size: 18rpx; font-weight: 900; color: #8B7E74; }
.stats-strip-value { font-size: 28rpx; font-weight: 900; }
.stats-orange .stats-strip-value { color: #E65100; }
.stats-blue .stats-strip-value { color: #1565C0; }
.stats-mint .stats-strip-value { color: #2E7D32; }
.stats-green .stats-strip-value { color: #388E3C; }

.salary-entry-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border: 3rpx solid #5E4E3E;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FFF7D6 0%, #FFE8C2 100%);
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.salary-entry-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

.salary-entry-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.salary-entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.salary-entry-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.salary-entry-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.salary-entry-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.salary-entry-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #7A6A58;
}

.salary-entry-btn {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid #5E4E3E;
  background: #FFFFFF;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
  font-size: 24rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.salary-preview-panel {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid #E7D5BA;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salary-preview-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.salary-preview-total-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #7A6A58;
}

.salary-preview-total-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #D35400;
}

.salary-preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.salary-preview-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #FFF8EC;
  border: 2rpx solid #E7D5BA;
  font-size: 22rpx;
  font-weight: 800;
  color: #5E4E3E;
}

.salary-preview-message {
  font-size: 22rpx;
  line-height: 1.6;
  color: #7A6A58;
}

.loading-wrap { display: flex; flex-direction: column; align-items: center; padding: 100rpx 0; }

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e6ed;
  border-left-color: #FF9F43;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text { margin-top: 20rpx; font-size: 26rpx; color: #8B7E74; }
.records-list { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 32rpx; }

.record-card {
  background: #fff;
  border: 4rpx solid #5E4E3E;
  border-radius: 32rpx;
  box-shadow: 6rpx 6rpx 0 #5E4E3E;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  overflow: hidden;
}

.record-top { display: flex; align-items: flex-start; gap: 20rpx; }

.record-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  border: 3rpx solid #5E4E3E;
  background: #FFE066;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-avatar-text { font-size: 36rpx; font-weight: 900; color: #5E4E3E; }
.record-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.record-name { font-size: 30rpx; font-weight: 900; color: #5E4E3E; }
.record-datetime { font-size: 22rpx; font-weight: 700; color: #8B7E74; font-family: monospace; }
.record-badge { padding: 10rpx 20rpx; border-radius: 999rpx; border: 2rpx solid; flex-shrink: 0; }
.record-badge-text { font-size: 20rpx; font-weight: 900; }

.badge-attendance { background: #E3F2FD; border-color: #90CAF9; }
.badge-attendance .record-badge-text { color: #1565C0; }
.badge-domestic-trip { background: #FFF3E0; border-color: #FFCC80; }
.badge-domestic-trip .record-badge-text { color: #E65100; }
.badge-foreign-trip { background: #FCE4EC; border-color: #F48FB1; }
.badge-foreign-trip .record-badge-text { color: #880E4F; }
.badge-rest { background: #E8F5E9; border-color: #A5D6A7; }
.badge-rest .record-badge-text { color: #2E7D32; }
.badge-other { background: #F3E5F5; border-color: #CE93D8; }
.badge-other .record-badge-text { color: #4A148C; }

.record-detail {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F9FAFB;
  border: 2rpx dashed #D1D5DB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.record-detail-left { flex: 1; display: flex; align-items: center; gap: 10rpx; min-width: 0; }

.detail-icon {
  width: 28rpx;
  height: 28rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  max-width: 28rpx;
  max-height: 28rpx;
  flex-shrink: 0;
  display: block;
}

.record-base-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9F43;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-subsidy {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF0F3;
  border: 1rpx solid #FFCDD2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.record-subsidy-text { font-size: 22rpx; font-weight: 900; color: #C62828; }

.record-normal-label {
  font-size: 20rpx;
  font-weight: 900;
  color: #2E7D32;
  opacity: 0.6;
  font-style: italic;
  flex-shrink: 0;
}

.record-top-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
}

.record-action-btns {
  display: flex;
  gap: 12rpx;
}

.record-btn-edit,
.record-btn-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #5E4E3E;
  border-radius: 16rpx;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
  background: #fff;
}

.record-btn-edit:active,
.record-btn-delete:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 #5E4E3E;
}

.record-btn-edit { background: #EFF6FF; }
.record-btn-delete { background: #FFF1F2; }

.action-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 60rpx;
  border: 4rpx dashed rgba(94,78,62,0.15);
  margin-bottom: 32rpx;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: #F3F4F6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon { width: 72rpx; height: 72rpx; opacity: 0.4; }
.empty-text { font-size: 30rpx; font-weight: 900; color: #8B7E74; margin-bottom: 24rpx; }
.empty-reset-btn { font-size: 24rpx; font-weight: 900; color: #FF9F43; text-decoration: underline; }
.bottom-spacer { height: 60rpx; }

.employee-popup {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.employee-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 36rpx 24rpx;
  border-bottom: 2rpx solid #F0F2F5;
}

.employee-popup-title { font-size: 32rpx; font-weight: 900; color: #5E4E3E; }
.employee-popup-header-btns { display: flex; gap: 16rpx; }
.emp-popup-btn { font-size: 24rpx; font-weight: 700; padding: 10rpx 24rpx; border-radius: 999rpx; }
.emp-clear { background: #FFEBEE; color: #C62828; }
.emp-all { background: #E3F2FD; color: #1565C0; }
.employee-list { flex: 1; overflow-y: auto; padding: 0 36rpx; max-height: 60vh; }
.employee-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.employee-item:last-child { border-bottom: none; }

.emp-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #D9D9D9;
  border-radius: 8rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  flex-shrink: 0;
}

.emp-checked { background: #1890ff; border-color: #1890ff; }
.emp-check-icon { color: #fff; font-size: 28rpx; font-weight: 900; }
.emp-name { font-size: 28rpx; color: #5E4E3E; font-weight: 700; }
.employee-empty { display: flex; justify-content: center; align-items: center; padding: 80rpx 0; }
.employee-empty-text { font-size: 28rpx; color: #8B7E74; }
.employee-popup-footer { padding: 24rpx 36rpx 36rpx; border-top: 2rpx solid #F0F2F5; }

.employee-confirm-btn {
  width: 100%;
  background: #FF9F43;
  color: #5E4E3E;
  border: 3rpx solid #5E4E3E;
  border-radius: 20rpx;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 900;
}

.confirm-popup {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin: 60rpx 40rpx;
}

.confirm-popup-title { font-size: 32rpx; font-weight: 900; color: #5E4E3E; text-align: center; margin-bottom: 20rpx; }
.confirm-popup-msg { font-size: 28rpx; color: #8B7E74; text-align: center; line-height: 1.5; margin-bottom: 40rpx; }
.confirm-popup-actions { display: flex; gap: 24rpx; }

.confirm-btn-cancel,
.confirm-btn-ok {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.confirm-btn-cancel { background: #F0F0F0; color: #8B7E74; }
.confirm-btn-ok { background: #FFEBEE; color: #C62828; border: 2rpx solid #FFCDD2; }

/* ==================== 编辑弹窗样式 ==================== */
.edit-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.edit-popup {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx 0;
  padding-bottom: 0;
  max-height: 85vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.edit-popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.edit-popup-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.edit-popup-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border-radius: 50%;
}

.close-icon { width: 32rpx; height: 32rpx; }

.edit-section { margin-bottom: 32rpx; }

.edit-label {
  font-size: 26rpx;
  font-weight: 900;
  color: #5E4E3E;
  margin-bottom: 16rpx;
  display: block;
}

.edit-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.edit-type-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 16rpx;
  border: 3rpx solid #D1D5DB;
  border-radius: 24rpx;
  background: #F9FAFB;
}

.edit-type-active {
  border-color: #5E4E3E;
  box-shadow: 3rpx 3rpx 0 #5E4E3E;
}

.edit-type-icon { width: 48rpx; height: 48rpx; }

.edit-type-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #5E4E3E;
}

.edit-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.edit-field { flex: 1; }

.edit-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F9FAFB;
  border: 3rpx solid #5E4E3E;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.edit-input-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.edit-input {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #5E4E3E;
  min-width: 0;
}

.edit-picker-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #5E4E3E;
}

.edit-save-btn {
  width: 100%;
  background: #FFCBA4;
  color: #5E4E3E;
  border: 4rpx solid #5E4E3E;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  text-align: center;
  padding: 32rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  margin-top: 16rpx;
  margin-bottom: 0;
  box-sizing: border-box;
}

.edit-save-spacer {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.edit-save-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

/* ==================== 保存结果弹窗样式 ==================== */
.result-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-modal {
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx 48rpx 48rpx;
  width: 560rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

.result-modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx dashed #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.result-icon-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon-success .result-icon-inner { background: #FFCBA4; }
.result-icon-fail .result-icon-inner { background: #FFB7C5; }

.result-icon-img { width: 64rpx; height: 64rpx; }

.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #5E4E3E;
  margin-bottom: 16rpx;
}

.result-msg {
  font-size: 26rpx;
  color: #8B7E74;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.result-confirm-btn {
  width: 100%;
  background: #fff;
  border: 4rpx solid #5E4E3E;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  color: #5E4E3E;
  box-sizing: border-box;
}

.result-confirm-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

/* ==================== 工资条弹窗样式 ==================== */
.salary-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
}

.salary-modal {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx 0;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.salary-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.salary-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #5E4E3E;
  line-height: 1.4;
}

.salary-modal-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8B7E74;
  line-height: 1.5;
}

.salary-lock-row {
  margin-top: 16rpx;
}

.salary-lock-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #5E4E3E;
  background: #FFF3CD;
  color: #5E4E3E;
  font-size: 22rpx;
  font-weight: 900;
}

.salary-lock-badge-manual {
  background: #DFF6E8;
  color: #176B3A;
}

.salary-lock-text {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7A6A58;
}

.salary-alert-card {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border: 2rpx solid #D0A85C;
  border-radius: 24rpx;
  background: #FFF7E8;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.4);
}

.salary-alert-title {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  color: #8A5A12;
  line-height: 1.5;
}

.salary-alert-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.8;
  color: #7A5A2F;
  white-space: pre-wrap;
}

.salary-alert-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salary-alert-item {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(208, 168, 92, 0.28);
}

.salary-alert-item-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.salary-alert-item-label {
  font-size: 24rpx;
  font-weight: 900;
  color: #714C16;
  line-height: 1.5;
}

.salary-alert-item-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7A5A2F;
}

.salary-alert-arrow {
  position: relative;
  width: 20rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.salary-alert-arrow-up {
  color: #D64545;
}

.salary-alert-arrow-down {
  color: #2F9E44;
}

.salary-alert-arrow-stem {
  position: absolute;
  left: 8rpx;
  width: 4rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.salary-alert-arrow-stem-up {
  top: 8rpx;
}

.salary-alert-arrow-stem-down {
  top: 4rpx;
}

.salary-alert-arrow-tip {
  position: absolute;
  left: 2rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
}

.salary-alert-arrow-tip-up {
  top: 0;
  border-bottom: 10rpx solid currentColor;
}

.salary-alert-arrow-tip-down {
  bottom: 0;
  border-top: 10rpx solid currentColor;
}

.salary-alert-overflow {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9A7B47;
}

.salary-modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
  flex-shrink: 0;
}

.salary-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.salary-form-grid-readonly {
  margin-top: 18rpx;
}

.salary-form-item {
  background: #FFFDF9;
  border: 3rpx solid #E8DDCC;
  border-radius: 24rpx;
  padding: 20rpx;
}

.salary-form-item-display {
  background: #F7F5F2;
}

.salary-form-item-readonly {
  margin-top: 18rpx;
}

.salary-form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.salary-form-label {
  font-size: 24rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.salary-info-btn {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #FFF4D8;
  border: 2rpx solid #D0A85C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.salary-info-btn-active {
  background: #F3D897;
}

.salary-info-btn-text {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 900;
  color: #8A5A12;
}

.salary-input-wrap {
  background: #FFFFFF;
  border: 3rpx solid #5E4E3E;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
}

.salary-input {
  width: 100%;
  font-size: 26rpx;
  font-weight: 700;
  color: #5E4E3E;
}

.salary-input-wrap-readonly {
  background: #F7F5F2;
}

.salary-input-readonly {
  display: block;
  line-height: 1.4;
}

.salary-form-expand {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FFF8EA;
  border: 2rpx dashed #DFC18A;
}

.salary-form-expand-title {
  display: block;
  font-size: 23rpx;
  font-weight: 900;
  color: #855718;
  line-height: 1.5;
}

.salary-form-expand-line {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7A5A2F;
}

.salary-info-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 2100;
  background: rgba(34, 28, 20, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.salary-info-popup {
  width: 100%;
  max-height: 82vh;
  background: #FFFDF8;
  border: 4rpx solid #5E4E3E;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 0 rgba(94, 78, 62, 0.18);
  overflow: hidden;
}

.salary-info-popup-header {
  min-height: 92rpx;
  padding: 24rpx 28rpx;
  background: #FFF4D8;
  border-bottom: 3rpx solid #E5C47A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.salary-info-popup-title {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: #5E4E3E;
  line-height: 1.35;
  overflow-wrap: break-word;
}

.salary-info-popup-close {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.salary-info-popup-body {
  max-height: calc(82vh - 96rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.salary-info-lines {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.salary-info-line {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: #6A5132;
  overflow-wrap: break-word;
}

.salary-info-receipt {
  margin-top: 0;
}

.salary-calc-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(208, 168, 92, 0.35);
}

.salary-calc-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.salary-calc-grid-two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.salary-calc-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.salary-calc-field-formula {
  margin-top: 14rpx;
}

.salary-calc-label {
  font-size: 21rpx;
  line-height: 30rpx;
  height: 60rpx;
  color: #8A6A3A;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.salary-calc-static {
  min-height: 76rpx;
  width: 100%;
  min-width: 0;
  display: block;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  background: #F8F3E9;
  border: 2rpx solid #D8C7AA;
  font-size: 24rpx;
  font-weight: 900;
  color: #5E4E3E;
  box-sizing: border-box;
  line-height: 1.35;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.salary-calc-input {
  min-height: 76rpx;
  width: 100%;
  min-width: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #5E4E3E;
  font-size: 24rpx;
  color: #2B2B2B;
  box-sizing: border-box;
}

.salary-calc-preview {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7A5A2F;
}

.salary-calc-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9A7B47;
}

.salary-calc-action {
  margin-top: 16rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #FFF3CD;
  border: 2rpx solid #D0A85C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  color: #855718;
}

.salary-form-helper {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8B7E74;
  line-height: 1.5;
}

.salary-total-card {
  margin-top: 28rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #DFF6E8 0%, #C8F0DB 100%);
  border: 3rpx solid #5E4E3E;
  border-radius: 28rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.salary-total-label {
  font-size: 26rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.salary-total-label-row {
  margin-bottom: 0;
}

.salary-total-expand {
  margin-top: 12rpx;
}

.salary-total-receipt {
  padding: 14rpx 0 4rpx;
}

.salary-receipt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 0;
}

.salary-receipt-label {
  font-size: 21rpx;
  line-height: 1.6;
  color: #4F6956;
}

.salary-receipt-value {
  font-size: 22rpx;
  line-height: 1.6;
  font-weight: 900;
  color: #2D5342;
}

.salary-receipt-divider {
  margin: 8rpx 0 6rpx;
  border-top: 2rpx dashed rgba(94, 78, 62, 0.28);
}

.salary-receipt-row-total .salary-receipt-label,
.salary-receipt-row-total .salary-receipt-value {
  color: #176B3A;
}

.salary-total-expand-line {
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  color: #4F6956;
}

.salary-total-value {
  font-size: 38rpx;
  font-weight: 900;
  color: #176B3A;
}

.salary-save-btn {
  width: 100%;
  background: #B5EAD7;
  color: #5E4E3E;
  border: 4rpx solid #5E4E3E;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.salary-save-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

.salary-save-btn-disabled {
  opacity: 0.65;
}

/* ===== 删除确认弹窗样式 ===== */
.delete-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.delete-modal {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 4rpx solid #5E4E3E;
  box-shadow: 8rpx 8rpx 0 #5E4E3E;
  padding: 48rpx 40rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.delete-modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-modal-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: #FFE4E6;
  border-radius: 28rpx;
  border: 4rpx solid #5E4E3E;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.delete-modal-icon-inner {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-modal-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.delete-modal-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #5E4E3E;
  margin-bottom: 16rpx;
}

.delete-modal-desc {
  font-size: 26rpx;
  color: #8B7E74;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.delete-modal-btns {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.delete-modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.delete-modal-btn-cancel {
  background: #FFFFFF;
  color: #5E4E3E;
  border: 4rpx solid #5E4E3E;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
}

.delete-modal-btn-cancel:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

.delete-modal-btn-confirm {
  background: #FF6B6B;
  color: #FFFFFF;
  border: 4rpx solid #5E4E3E;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
}

.delete-modal-btn-confirm:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}

/* ===== 删除进度弹窗样式 ===== */
.delete-progress-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.delete-progress-card {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border: 4rpx solid #5E4E3E;
  border-radius: 32rpx;
  box-shadow: 8rpx 8rpx 0 #5E4E3E;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.delete-progress-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #5E4E3E;
  margin-bottom: 16rpx;
}

.delete-progress-desc {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #8B7E74;
  margin-bottom: 32rpx;
}

.delete-progress-bar-wrap {
  position: relative;
  margin-bottom: 24rpx;
  width: 100%;
}

.delete-progress-bar-bg {
  height: 48rpx;
  background: #f0f0f0;
  border-radius: 24rpx;
  border: 3rpx solid #5E4E3E;
  overflow: hidden;
}

.delete-progress-bar-fill {
  height: 100%;
  background: #FFB7C5;
  border-radius: 24rpx;
  transition: width 0.3s ease;
}

.delete-progress-percent {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 24rpx;
  font-weight: 900;
  color: #5E4E3E;
}

.delete-progress-tip {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #8B7E74;
  opacity: 0.7;
}

/* ===== 删除结果弹窗样式 ===== */
.delete-result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.delete-result-card {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 4rpx solid #5E4E3E;
  box-shadow: 8rpx 8rpx 0 #5E4E3E;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.delete-result-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-result-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx dashed #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.delete-result-icon-inner {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-result-success .delete-result-icon-inner { background: #B5EAD7; }
.delete-result-fail .delete-result-icon-inner { background: #FFB7C5; }

.delete-result-icon-img { width: 48rpx; height: 48rpx; }

.delete-result-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #5E4E3E;
  margin-bottom: 24rpx;
}

.delete-steps-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.delete-step-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
}

.delete-step-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.delete-step-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #2E7D32;
  flex: 1;
}

.delete-step-fail {
  color: #C62828;
}

.delete-result-confirm-btn {
  width: 100%;
  background: #FFCBA4;
  color: #5E4E3E;
  border: 4rpx solid #5E4E3E;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #5E4E3E;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 900;
}

.delete-result-confirm-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 #5E4E3E;
}
