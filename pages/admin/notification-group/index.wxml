<view class="notification-group-container">
  <view class="page-header">
    <view class="header-icon-wrapper">
      <image class="header-icon" src="/assets/icons/feishu.svg" mode="aspectFit" />
    </view>
    <text class="page-title">飞书通知管理</text>
    <text class="page-subtitle">保存后会直接热更新到后端，无需重启</text>
  </view>

  <view class="cartoon-card summary-card" wx:if="{{!loading}}">
    <view class="summary-item">
      <text class="summary-label">通知开关</text>
      <text class="summary-value {{summary.enabled ? 'summary-on' : 'summary-off'}}">{{summary.enabled ? '已开启' : '已关闭'}}</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">接收人</text>
      <text class="summary-value">{{summary.openIdCount}} 个 open_id</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">消息格式</text>
      <text class="summary-value">{{summary.formatLabel}}</text>
    </view>
  </view>

  <view class="cartoon-card loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <view class="sync-card">
      <view class="sync-copy">
        <text class="sync-title">从飞书 CLI 自动同步</text>
        <text class="sync-desc">自动读取后端本机 lark-cli 的 App ID 和当前授权用户 open_id；配置完成后可直接发送测试通知。</text>
      </view>
      <view class="sync-actions">
        <view class="macaron-btn macaron-btn-mint sync-btn {{syncingCli ? 'btn-disabled' : ''}}" bindtap="syncFromCli">同步</view>
        <view class="macaron-btn macaron-btn-blue sync-btn {{testingNotify ? 'btn-disabled' : ''}}" bindtap="sendTestNotification">测试通知</view>
      </view>
    </view>

    <view class="cartoon-card form-card">
      <view class="form-row switch-row">
        <view>
          <text class="form-title">启用飞书私聊通知</text>
          <text class="form-desc">工资统计、任务通知会通过飞书智能体私聊发送</text>
        </view>
        <switch checked="{{formData.FEISHU_TASK_NOTIFY_ENABLED === 'true'}}" bindchange="onToggleEnabled" color="#FFB36B" />
      </view>
    </view>

    <view class="cartoon-card form-card">
      <view class="section-title">基础配置</view>

      <view class="form-group">
        <text class="form-label">飞书 App ID</text>
        <input class="form-input-macaron" placeholder="请输入飞书 App ID" value="{{formData.FEISHU_APP_ID}}" data-key="FEISHU_APP_ID" bindinput="onFieldInput" />
        <text class="form-hint">飞书开放平台应用凭证。</text>
      </view>

      <view class="form-group">
        <text class="form-label">飞书 App Secret</text>
        <input class="form-input-macaron" password="true" placeholder="请输入飞书 App Secret" value="{{formData.FEISHU_APP_SECRET}}" data-key="FEISHU_APP_SECRET" bindinput="onFieldInput" />
        <text class="form-hint">仅管理员可见，保存后会写入 .env。</text>
      </view>

      <view class="form-group">
        <text class="form-label">接收人 open_id</text>
        <textarea class="form-textarea-macaron" placeholder="多个 open_id 用英文逗号分隔" value="{{formData.FEISHU_TASK_NOTIFY_OPEN_IDS}}" data-key="FEISHU_TASK_NOTIFY_OPEN_IDS" bindinput="onFieldInput"></textarea>
        <text class="form-hint">例如：ou_xxx,ou_yyy。当前默认用户不会自动推导，必须明确填写。</text>
      </view>

      <view class="form-group inline-group">
        <view class="inline-field">
          <text class="form-label">请求超时（秒）</text>
          <input class="form-input-macaron" type="number" placeholder="15" value="{{formData.FEISHU_TASK_NOTIFY_TIMEOUT}}" data-key="FEISHU_TASK_NOTIFY_TIMEOUT" bindinput="onFieldInput" />
        </view>
        <view class="inline-field">
          <text class="form-label">消息格式</text>
          <picker mode="selector" range="{{formatOptions}}" range-key="label" value="{{formatIndex}}" bindchange="onFormatChange">
            <view class="picker-box">
              <text class="picker-text">{{formatOptions[formatIndex].label}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="cartoon-card form-card">
      <view class="section-title">可编辑键</view>
      <view class="config-list">
        <view class="config-item" wx:for="{{settings}}" wx:key="key">
          <view class="config-meta">
            <text class="config-label">{{item.label}}</text>
            <text class="config-key-tag">{{item.key}}</text>
          </view>
          <text class="config-hint">{{item.hint}}</text>
          <text class="config-value">{{item.value || '(未设置)'}}</text>
        </view>
      </view>
    </view>

    <view class="action-row">
      <view class="macaron-btn macaron-btn-lavender action-btn" bindtap="resetSettings">重置</view>
      <view class="macaron-btn macaron-btn-peach action-btn {{saving ? 'btn-disabled' : ''}}" bindtap="saveSettings">保存并热更新</view>
    </view>
  </block>
</view>
