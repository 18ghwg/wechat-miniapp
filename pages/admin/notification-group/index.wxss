/* 飞书通知设置页面样式 - Macaron Theme */
@import '/style/macaron-theme.wxss';

.notification-group-container {
  padding: 0 30rpx 60rpx;
  background-color: var(--background);
  min-height: 100vh;
}

.page-header {
  padding: 40rpx 0 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: var(--color-peach-macaron);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border: 4rpx solid var(--foreground);
  box-shadow: 6rpx 6rpx 0rpx var(--foreground);
}

.header-icon {
  width: 56rpx;
  height: 56rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.summary-card,
.form-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.sync-card {
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: var(--color-mint-macaron);
  border: 4rpx solid var(--foreground);
  border-radius: var(--radius-cartoon);
  box-shadow: 6rpx 6rpx 0rpx var(--foreground);
}

.sync-copy {
  flex: 1;
  min-width: 0;
}

.sync-title {
  display: block;
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.sync-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted-foreground);
}

.sync-btn {
  min-width: 140rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding-left: 18rpx;
  padding-right: 18rpx;
  font-size: 26rpx;
}

.sync-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
  max-width: 330rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-label {
  font-size: 26rpx;
  color: var(--muted-foreground);
}

.summary-value {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  text-align: right;
}

.summary-on {
  color: #2E7D32;
}

.summary-off {
  color: #B45309;
}

.form-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.switch-row {
  align-items: center;
}

.form-title {
  display: block;
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.form-desc {
  display: block;
  font-size: 24rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
  margin-bottom: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 3rpx solid var(--border);
}

.form-group {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  color: var(--foreground);
  margin-bottom: 12rpx;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted-foreground);
  margin-top: 10rpx;
  line-height: 1.5;
}

.form-textarea-macaron {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 24rpx 30rpx;
  border: 4rpx solid var(--border);
  border-radius: var(--radius-lg);
  background-color: var(--card);
  font-size: 28rpx;
  color: var(--foreground);
}

.inline-group {
  display: flex;
  gap: 20rpx;
}

.inline-field {
  flex: 1;
  min-width: 0;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 30rpx;
  border: 4rpx solid var(--border);
  border-radius: var(--radius-lg);
  background-color: var(--card);
}

.picker-text {
  font-size: 28rpx;
  color: var(--foreground);
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

.config-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.config-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.config-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.config-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.config-label {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--foreground);
}

.config-key-tag {
  font-size: 22rpx;
  color: var(--muted-foreground);
  background: var(--muted);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-family: monospace;
}

.config-hint {
  display: block;
  font-size: 24rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.config-value {
  display: block;
  font-size: 26rpx;
  color: var(--foreground);
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.action-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--muted-foreground);
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .loading-spinner {
    animation: none;
  }
}
