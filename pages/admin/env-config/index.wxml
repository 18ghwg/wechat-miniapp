<view class="env-config-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-icon-wrapper">
      <image class="header-icon" src="/assets/icons/settings.png" mode="aspectFit" />
    </view>
    <text class="page-title">环境配置管理</text>
    <text class="page-subtitle">修改后立即热更新生效，无需重启服务</text>
  </view>

  <!-- 加载状态 -->
  <view class="cartoon-card loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 配置分组列表 -->
  <block wx:if="{{!loading}}">
    <view
      wx:for="{{groups}}"
      wx:for-item="group"
      wx:for-index="groupIndex"
      wx:key="group"
      class="cartoon-card group-card"
    >
      <view class="group-title">{{group.group}}</view>

      <view
        wx:for="{{group.items}}"
        wx:for-item="cfg"
        wx:for-index="itemIndex"
        wx:key="key"
        class="config-item"
      >
        <!-- 配置标签和说明 -->
        <view class="config-meta">
          <text class="config-label">{{cfg.label}}</text>
          <text class="config-key-tag">{{cfg.key}}</text>
        </view>
        <text class="config-hint" wx:if="{{cfg.hint}}">{{cfg.hint}}</text>

        <!-- 非编辑态 -->
        <view
          wx:if="{{!cfg.editing}}"
          class="config-value-row"
          bindtap="onEditItem"
          data-group-index="{{groupIndex}}"
          data-item-index="{{itemIndex}}"
        >
          <text class="config-value {{cfg.value ? '' : 'empty'}}">{{cfg.value || '(未设置)'}}</text>
          <view class="macaron-btn macaron-btn-yellow edit-btn">编辑</view>
        </view>

        <!-- 编辑态 -->
        <view wx:else class="edit-row">
          <input
            class="form-input-macaron"
            value="{{cfg.editValue}}"
            bindinput="onInputChange"
            data-group-index="{{groupIndex}}"
            data-item-index="{{itemIndex}}"
            placeholder="请输入值"
            confirm-type="done"
          />
          <view class="edit-actions">
            <view
              class="macaron-btn macaron-btn-lavender"
              bindtap="onCancelEdit"
              data-group-index="{{groupIndex}}"
              data-item-index="{{itemIndex}}"
            >取消</view>
            <view
              class="macaron-btn macaron-btn-peach {{saving ? 'btn-disabled' : ''}}"
              bindtap="onSaveItem"
              data-group-index="{{groupIndex}}"
              data-item-index="{{itemIndex}}"
            >保存</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 刷新按钮 -->
    <view class="refresh-container">
      <view class="macaron-btn macaron-btn-mint refresh-btn" bindtap="onRefresh">刷新配置</view>
    </view>
  </block>
</view>
